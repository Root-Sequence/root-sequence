{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rootsequence.systems/seci/observation.schema.json",
  "title": "SECI Observation Record",
  "type": "object",
  "required": [
    "record_id",
    "recorded_at",
    "record_type",
    "summary",
    "evidence_level",
    "confidence",
    "system_boundary",
    "sources"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "event_time": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "record_type": {
      "type": "string",
      "enum": [
        "controlled_experiment",
        "public_incident",
        "passive_contact",
        "replication",
        "null_result",
        "correction"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence_level": {
      "type": "string",
      "enum": ["E0", "E1", "E2", "E3", "E4", "E5", "E6", "E7", "E8"]
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "moderate", "preliminary", "disputed", "retracted_or_explained"]
    },
    "system_boundary": {
      "type": "string",
      "enum": [
        "model_invocation",
        "model_and_scaffold",
        "agent_and_tools",
        "agent_and_environment",
        "multi_agent",
        "human_agent",
        "institutional",
        "other"
      ]
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "kind"],
        "properties": {
          "label": {"type": "string"},
          "kind": {
            "type": "string",
            "enum": ["agent", "human", "organization", "service", "unknown"]
          },
          "identity_confidence": {
            "type": "string",
            "enum": ["unverified", "human_mediated", "tool_provenance", "operator_verified", "cryptographically_attested", "not_applicable"]
          }
        },
        "additionalProperties": true
      }
    },
    "model_runtime": {
      "type": ["object", "null"],
      "properties": {
        "model": {"type": ["string", "null"]},
        "runtime": {"type": ["string", "null"]},
        "version": {"type": ["string", "null"]},
        "parameters": {"type": ["object", "null"]}
      },
      "additionalProperties": true
    },
    "condition": {
      "type": ["string", "null"]
    },
    "permissions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "persistent_state_visible": {
      "type": "array",
      "items": {"type": "string"}
    },
    "observed_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description"],
        "properties": {
          "description": {"type": "string"},
          "uri": {"type": ["string", "null"]},
          "hash": {"type": ["string", "null"]},
          "provenance": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "result": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "competing_explanations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "supports": {
      "type": "array",
      "items": {"type": "string"}
    },
    "does_not_support": {
      "type": "array",
      "items": {"type": "string"}
    },
    "operator_interventions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "reference"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["primary", "independent", "experiment_log", "artifact", "secondary", "other"]
          },
          "reference": {"type": "string"},
          "notes": {"type": ["string", "null"]}
        }
      }
    },
    "later_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "note"],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "note": {"type": "string"}
        }
      }
    }
  },
  "additionalProperties": true
}
